# ArogyaVaani Root Environment Configuration (Template)
# Copy to .env and configure for your deployment

# Security & Tokens
JWT_SECRET=replace-with-a-32-character-or-longer-random-secret
ADMIN_EMAIL=admin@your-hospital-network.org
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Central API & Database
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/arogyavaani
MONGODB_DB=arogyavaani
MODEL_ARTIFACT_ROOT=./backend/model_artifacts
MODEL_UPDATE_MAX_BYTES=200mb
FRONTEND_ORIGIN=http://localhost:5173

# Optional OAuth
GOOGLE_CLIENT_ID=
